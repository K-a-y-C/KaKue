{
  "name": "kakue-robot-door-scan-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "prepare:assets": "node scripts/prepare-runtime-assets.mjs",
    "predev": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets",
    "test:numerical": "node --test tests/numerical/*.test.ts",
    "verify:release": "node scripts/verify-static-release.mjs",
    "test:release": "node --test tests/release/*.test.ts",
    "test:presenter": "PREVIEW=1 PRESENTER=1 playwright test tests/browser/delivery.spec.ts -g hardware"
  },
  "dependencies": {
    "occt-import-js": "0.0.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
